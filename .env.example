# Aplicacao
APP_ENV=dev
LOG_LEVEL=INFO

# Ollama local - agente principal
# Em maquinas com falha de CUDA, LLM_NUM_GPU=28 evita carregar todas as
# camadas na GPU; use 0 para forcar CPU.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_S=180
LLM_NUM_GPU=28

# Ollama Cloud - alternativa com creditos
# OLLAMA_API_KEY=sua_chave_real
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=gpt-oss:20b
# LLM_NUM_GPU=

# Ollama local - juiz RAGAS
RAGAS_JUDGE_API_KEY=
RAGAS_JUDGE_BASE_URL=http://127.0.0.1:11434
RAGAS_JUDGE_MODEL=qwen2.5:7b
RAGAS_JUDGE_TIMEOUT_S=600

# Embeddings locais
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
HF_HOME=./.cache/huggingface

# Base documental e indice
BASE_DOCS_DIR=./base_documental
CHROMA_DIR=./data/chroma
ECOPONTOS_DATA_PATH=./data/ecopontos.json
EVALUATION_DATASET_PATH=./src/ecocidadao/evaluation/dataset.json
RAGAS_OUTPUT_PATH=./avaliacao_ragas.json
CHUNKING_EXPERIMENT_PATH=./data/experiments/chunking_comparison.json

# Recuperacao
COLLECTION_NAME=ecocidadao_markdown
RETRIEVAL_TOP_K=6
RETRIEVAL_FETCH_K=20
RETRIEVAL_SCORE_THRESHOLD=0.35
MAX_CONTEXT_CHARS=8000
MAX_INPUT_CHARS=2000
MAX_TOOL_CALLS=6

# Interface Gradio
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
